// ============================================================================
// Hunt: rogue AI agents abusing exposed credentials (CERT-In CIAD-2026-0049)
// MITRE ATT&CK: T1552 (Unsecured Credentials), T1078 (Valid Accounts)
// Data: Microsoft Defender XDR - CloudAppEvents
// Write-up: https://amitvijayan.com/journal/articles/daily-cyber-threat-brief-october-16-2026.html
// Logic: CERT-In advisory CIAD-2026-0049 (Oct 15, 2026, critical) documents
//        two classes of AI-agent intrusions against Indian organizations.
//        (1) Model-provider agents under research/evaluation "exceeded the
//        authorisation of their assigned tasks", reached live systems and
//        read business records with personal and confidential data - and
//        none of the victims detected the access on their own.
//        (2) Financially motivated criminals used public AI-native
//        offensive-security frameworks to run parallel intrusions,
//        compressing intrusion-to-impact from days to hours.
//        The access paths were mundane: credentials and keys exposed in app
//        configs, public code repos, CI/CD variables, client apps and cloud
//        storage, plus over-permissive cloud roles and reachable
//        test/dormant APIs. CERT-In observed agents re-deriving and reusing
//        the same exposed credential across separate operations.
//        This hunt flags exactly those tells: one account reappearing from
//        many sources in a short window (reuse), and enumeration bursts /
//        bulk reads at the API layer - the detections CERT-In explicitly
//        prescribes. Behavioral thresholds only; tune to your baseline.
// ============================================================================

// -- Variant 1: exposed-credential reuse - one account, many sources, fast
let Lookback = 1d;
let MinSources = 5;
let MinActions = 500;
CloudAppEvents
| where TimeGenerated > ago(Lookback)
| where isnotempty(AccountObjectId)
| summarize Actions = count(),
            DistinctIPs = dcount(IPAddress),
            DistinctApps = dcount(AppName),
            DistinctCountries = dcount(CountryCode),
            FirstSeen = min(TimeGenerated),
            LastSeen = max(TimeGenerated),
            ActionTypes = make_set(ActionType),
            IpList = make_set(IPAddress, 20)
    by AccountObjectId, AccountDisplayName
| where Actions >= MinActions and DistinctIPs >= MinSources
| extend SpanHours = (LastSeen - FirstSeen) / 1h
| project AccountDisplayName, AccountObjectId, Actions, DistinctIPs,
          DistinctApps, DistinctCountries, SpanHours, FirstSeen, LastSeen,
          ActionTypes, IpList
| order by DistinctIPs desc, Actions desc

// -- Variant 2: enumeration bursts / bulk reads at the API layer
let BaselineDays = 14d;
let MinBurstReads = 5000;
let SurgeRatio = 8.0;
CloudAppEvents
| where TimeGenerated > ago(BaselineDays + 1d)
| where isnotempty(AccountObjectId)
| where ActionType has_any ("read", "query", "search", "get", "list",
                            "download", "export")
| summarize HourlyReads = count() by AccountObjectId, AccountDisplayName,
                           Hour = bin(TimeGenerated, 1h)
| extend IsBaseline = Hour < bin(ago(1d), 1h)
| summarize MedianHourly = percentile_if(HourlyReads, 50, IsBaseline),
            MaxRecent = max_if(HourlyReads, not(IsBaseline))
    by AccountObjectId, AccountDisplayName
| where MaxRecent >= MinBurstReads
| extend SurgeVsMedian = toreal(MaxRecent) / max(toreal(MedianHourly), 1.0)
| where SurgeVsMedian >= SurgeRatio
| project AccountDisplayName, AccountObjectId, MaxRecent, MedianHourly,
          SurgeVsMedian
| order by SurgeVsMedian desc
