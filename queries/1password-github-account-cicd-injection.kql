// ============================================================================
// Hunt: 1Password breach - compromised employee GitHub account used to
//   inject malicious code into backend services and steal customer
//   account records
// MITRE ATT&CK: T1078 (Valid Accounts), T1195.002 (Supply Chain
//   Compromise: Compromise Software Supply Chain), T1552.001 (Unsecured
//   Credentials: Credentials in Files), T1566.002 (Phishing:
//   Spearphishing Link)
// Data: cloud app events (CloudAppEvents), process events
//   (DeviceProcessEvents), file events (DeviceFileEvents), email events
//   (EmailEvents), URL click events (UrlClickEvents)
// Write-up: https://amitvijayan.com/journal/articles/daily-cyber-threat-brief-november-26-2026.html
// Logic: 1Password disclosed on November 25, 2026 that an attacker
// compromised an employee's corporate GitHub account and used it to
// reach private source code repositories, copy source code, and get
// into the company's CI/CD environment. Malicious code injected into
// backend services then downloaded customer account records for a
// subset of customers. The stolen data: customer names and sign-in
// email addresses, account and user IDs, account creation and last
// sign-in timestamps, public cryptographic keys, Secure Remote
// Password (SRP) protocol parameters, and tokens embedded in emailed
// links for invitations, provisioning and account recovery, plus other
// non-secret internal account metadata. 1Password says vault contents
// and the keys protecting them were "at no point" available to the
// attacker, that the stolen tokens cannot be used on their own to
// access accounts (they need single sign-on authentication or a
// six-digit verification code), and that it has found no internal
// evidence of customer account takeovers. The company disabled the
// compromised GitHub account, revoked the stolen token, restored
// clean versions of the affected services, rotated or revoked
// potentially exposed infrastructure credentials, and lengthened
// invitation and recovery codes. What is NOT known: how many
// customers were affected, how the attacker first got into the
// employee's GitHub account, or who the attacker is. No hashes, IPs
// or domains were published, so these queries hunt the pattern, not
// an indicator: a trusted developer account behaving abnormally on
// GitHub, CI/CD runners and backend services spawning unexpected
// children or touching credential material, bulk repo pulls, and
// phishing that reuses the stolen names, sign-in emails and
// invitation/recovery tokens. The 30-day lookback is Defender's
// advanced-hunting retention; the investigation began November 19,
// 2026, so it fits inside the window.
// ============================================================================

// -- Variant 1: GitHub audit-log anomalies - first-seen IP for a user --
// The intrusion started from a compromised employee GitHub account.
// If GitHub is a connected app in Defender for Cloud Apps, its audit
// events land in CloudAppEvents. Hunt pushes, clones, and token/key
// management actions from an IP the account has never used before.
// A first-seen IP is a triage signal, not proof of compromise -
// developers travel and use new networks, so check the action and
// the IP before escalating.
let Baseline = CloudAppEvents
| where TimeGenerated between (ago(60d) .. ago(30d))
| where Application has "GitHub"
| summarize by AccountDisplayName, IPAddress;
CloudAppEvents
| where TimeGenerated > ago(30d)
| where Application has "GitHub"
| where ActionType has "push" or ActionType has "clone"
    or ActionType has "token" or ActionType has "key"
    or ActionType has "deploy"
| join kind=leftanti Baseline on AccountDisplayName, IPAddress
| project TimeGenerated, AccountDisplayName, ActionType, IPAddress,
          CountryCode, City, RawEventData
| order by TimeGenerated desc

// -- Variant 1b: GitHub token and deploy-key creation --
// Same table, no baseline needed: any new personal access token,
// OAuth authorization, deploy key or Actions secret touched by an
// account is worth a look when it coincides with the intrusion
// window. Triage on whether the account normally manages tokens and
// whether the change was followed by repo or CI/CD activity.
CloudAppEvents
| where TimeGenerated > ago(30d)
| where Application has "GitHub"
| where ActionType has "token" or ActionType has "key"
    or ActionType has "secret" or ActionType has "deploy"
| project TimeGenerated, AccountDisplayName, ActionType, IPAddress,
          CountryCode, City, RawEventData
| order by TimeGenerated desc

// -- Variant 2: git / gh burst - bulk repo pulls in a short window --
// The attacker copied source code from private repositories. On
// endpoints, hunt git or gh cloning, fetching or pushing at a volume
// no normal developer session produces in an hour. Tune the
// threshold to your environment; a single large monorepo clone can
// clear 20 operations legitimately, so check the repo names and the
// account before escalating.
DeviceProcessEvents
| where TimeGenerated > ago(30d)
| where FileName in~ ("git.exe", "git", "gh.exe", "gh")
| where ProcessCommandLine has "clone"
    or ProcessCommandLine has "fetch"
    or ProcessCommandLine has "pull"
    or ProcessCommandLine has "push"
| summarize OperationCount = count(),
            Repos = make_set(ProcessCommandLine, 20),
            FirstSeen = min(TimeGenerated),
            LastSeen = max(TimeGenerated)
    by bin(TimeGenerated, 1h), DeviceName, AccountName
| where OperationCount > 20
| order by OperationCount desc

// -- Variant 2b: git / gh credential and token handling --
// Hunt git or gh commands that surface credentials: gh auth token,
// gh api calls, and git credential helpers. Legitimate developers
// run these too, so triage on the parent process - a build agent,
// a scheduled task, or an unfamiliar binary running them is the
// signal, not the command itself.
DeviceProcessEvents
| where TimeGenerated > ago(30d)
| where FileName in~ ("git.exe", "git", "gh.exe", "gh")
| where ProcessCommandLine has "auth token"
    or ProcessCommandLine has "credential"
    or (ProcessCommandLine has "api" and ProcessCommandLine has "repos")
| project TimeGenerated, DeviceName, AccountName, FileName,
          ProcessCommandLine, InitiatingProcessFileName,
          InitiatingProcessCommandLine
| order by TimeGenerated desc

// -- Variant 3: CI/CD runner spawning unexpected children --
// The attacker reached the CI/CD environment and injected code into
// backend services. Hunt self-hosted runner processes spawning
// shells, downloaders or credential-access tools. Runners run build
// scripts legitimately, so the signal is the child: a shell or
// downloader outside a known build step, or a child reading
// credential material. Add your own runner binaries to the list.
DeviceProcessEvents
| where TimeGenerated > ago(30d)
| where InitiatingProcessFileName in~ ("Runner.Listener.exe",
    "Runner.Worker.exe", "gitlab-runner.exe",
    "azure-pipelines-agent.exe", "buildagent.exe", "jenkins.exe")
| where FileName in~ ("cmd.exe", "powershell.exe", "pwsh.exe",
    "bash", "sh", "curl.exe", "wget.exe", "bitsadmin.exe",
    "certutil.exe", "rundll32.exe", "reg.exe")
| project TimeGenerated, DeviceName, AccountName, FileName,
          ProcessCommandLine, InitiatingProcessFileName,
          InitiatingProcessCommandLine
| order by TimeGenerated desc

// -- Variant 3b: runner or build process touching credential files --
// Same parent set, tighter filter: a build or CI process reading
// SSH keys, cloud credential files, Docker config, npmrc or
// environment files is the credential-harvesting step the
// 1Password attacker needed for infrastructure credentials. The
// command-line match is broad by design - check the file actually
// opened before escalating.
DeviceProcessEvents
| where TimeGenerated > ago(30d)
| where InitiatingProcessFileName in~ ("Runner.Listener.exe",
    "Runner.Worker.exe", "gitlab-runner.exe",
    "azure-pipelines-agent.exe", "buildagent.exe", "jenkins.exe",
    "git.exe", "gh.exe")
| where ProcessCommandLine has ".ssh"
    or ProcessCommandLine has "id_rsa"
    or ProcessCommandLine has ".aws"
    or ProcessCommandLine has "credentials"
    or ProcessCommandLine has ".docker"
    or ProcessCommandLine has ".npmrc"
    or ProcessCommandLine has ".env"
| project TimeGenerated, DeviceName, AccountName, FileName,
          ProcessCommandLine, InitiatingProcessFileName,
          InitiatingProcessCommandLine
| order by TimeGenerated desc

// -- Variant 4: backend-service process spawning shells or downloaders --
// The injected code ran inside backend services and downloaded
// customer account records. Hunt service runtimes spawning shells,
// script interpreters or downloaders - a web or API service should
// not be launching cmd, PowerShell, curl or Python as a child.
// Triage on the service: a deployment or admin task can explain a
// one-off, but a service spawning a shell at 3 a.m. cannot.
DeviceProcessEvents
| where TimeGenerated > ago(30d)
| where InitiatingProcessFileName in~ ("node.exe", "python.exe",
    "dotnet.exe", "w3wp.exe", "java.exe", "nginx.exe", "httpd.exe")
| where FileName in~ ("cmd.exe", "powershell.exe", "pwsh.exe",
    "bash", "sh", "curl.exe", "wget.exe", "bitsadmin.exe",
    "python.exe", "perl.exe", "ruby.exe")
| project TimeGenerated, DeviceName, AccountName, FileName,
          ProcessCommandLine, InitiatingProcessFileName,
          InitiatingProcessCommandLine
| order by TimeGenerated desc

// -- Variant 4b: new executable or script files written by a service --
// Injected backend code often drops a payload or a helper script.
// Hunt new executable, library or script files written by a service
// runtime. Legitimate services write logs and caches, not .exe,
// .dll, .ps1 or .sh files - check the destination path and whether
// the file was later executed.
DeviceFileEvents
| where TimeGenerated > ago(30d)
| where InitiatingProcessFileName in~ ("node.exe", "python.exe",
    "dotnet.exe", "w3wp.exe", "java.exe", "nginx.exe", "httpd.exe")
| where FileName endswith ".exe" or FileName endswith ".dll"
    or FileName endswith ".ps1" or FileName endswith ".sh"
    or FileName endswith ".bat"
| project TimeGenerated, DeviceName, AccountName, FileName, FolderPath,
          InitiatingProcessFileName, InitiatingProcessCommandLine
| order by TimeGenerated desc

// -- Variant 5: phishing follow-on - 1Password-themed invitation or
//   recovery mail from a first-seen sender domain --
// The stolen data makes targeted phishing the realistic follow-on:
// a message using a real name and a real sign-in address, with a
// fake invitation, provisioning or account-recovery link carrying a
// stolen token. Hunt 1Password-themed invitation/recovery mail from
// a sender domain your org has never seen send such mail before.
// The anti-join builds a 30-day baseline of sender domains for
// 1Password-themed mail; anything outside it is a triage signal.
// Verify through the official app, never through the link.
let KnownSenders = EmailEvents
| where TimeGenerated between (ago(60d) .. ago(30d))
| where Subject has "1Password"
| summarize by SenderFromDomain;
EmailEvents
| where TimeGenerated > ago(30d)
| where Subject has "1Password"
| where Subject has "invit" or Subject has "recover"
    or Subject has "provision" or Subject has "reset"
| join kind=leftanti KnownSenders on SenderFromDomain
| project TimeGenerated, RecipientEmailAddress, SenderFromAddress,
          SenderFromDomain, Subject, DeliveryAction, DeliveryLocation,
          ThreatTypes
| order by TimeGenerated desc

// -- Variant 5b: clicks on 1Password-themed links in mail --
// Pair with variant 5: users who clicked a link in a
// 1Password-themed message. A click on a first-seen sender's link
// is the highest-priority triage - check whether the user entered
// credentials or an SSO flow afterwards.
UrlClickEvents
| where TimeGenerated > ago(30d)
| where Url has "1password"
| project TimeGenerated, AccountUpn, DeviceName, Url, IPAddress,
          IsClickedThrough
| order by TimeGenerated desc
