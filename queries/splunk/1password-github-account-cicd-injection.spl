// Splunk SPL equivalents for the KQL hunting queries.
// Feed it your Sysmon/process-creation, file-creation and
// network-connection events, your GitHub audit logs, and your email
// gateway logs. Replace the index names with your own.
// Same logic, same write-up. Incident window: 1Password began
// investigating on November 19, 2026 and disclosed on November 25,
// 2026; run the 30-day lookback and check GitHub audit logs for the
// full window. No hashes, IPs or domains were published - these
// queries hunt the pattern, not an indicator.

// -- Variant 1: GitHub audit-log anomalies - first-seen IP for a user --
// The intrusion started from a compromised employee GitHub account.
// Hunt pushes, clones, and token/key management actions from an IP
// the account has never used before. Replace index=github with your
// GitHub audit-log index and adjust the action field names to your
// GitHub add-on's field extraction.
index=github earliest=-30d
| search (action="git.push" OR action="git.clone" OR action="oauth_authorization.create"
    OR action="personal_access_token.create" OR action="deploy_key.create"
    OR action="org.invite_member")
| stats earliest(_time) as first_seen, values(action) as actions,
    values(actor) as actor by actor_ip, actor
| where first_seen > relative_time(now(), "-30d")
| table first_seen, actor, actor_ip, actions
| sort - first_seen

// -- Variant 1b: GitHub token and deploy-key creation --
// Same source, no baseline needed: any new personal access token,
// OAuth authorization, deploy key or Actions secret is worth a look
// when it coincides with the intrusion window. Triage on whether
// the account normally manages tokens.
index=github earliest=-30d
| search (action="*token*" OR action="*key*" OR action="*secret*"
    OR action="*deploy*")
| table _time, actor, actor_ip, action, repo
| sort - _time

// -- Variant 2: git / gh burst - bulk repo pulls in a short window --
// The attacker copied source code from private repositories. Hunt
// git or gh cloning, fetching or pushing at a volume no normal
// developer session produces in an hour. Tune the threshold to your
// environment; a single large monorepo clone can clear 20
// operations legitimately.
index=os (sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational"
    OR sourcetype="linux:sysmon") EventCode=1 earliest=-30d
| search (Image="*git.exe" OR Image="*git" OR Image="*gh.exe" OR Image="*gh")
    (CommandLine="*clone*" OR CommandLine="*fetch*"
    OR CommandLine="*pull*" OR CommandLine="*push*")
| bucket _time span=1h
| stats count as OperationCount, values(CommandLine) as Repos,
    min(_time) as FirstSeen, max(_time) as LastSeen
    by _time, host, user
| where OperationCount > 20
| sort - OperationCount

// -- Variant 2b: git / gh credential and token handling --
// Hunt git or gh commands that surface credentials: gh auth token,
// gh api calls, and git credential helpers. Triage on the parent
// process - a build agent, a scheduled task, or an unfamiliar
// binary running them is the signal, not the command itself.
index=os (sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational"
    OR sourcetype="linux:sysmon") EventCode=1 earliest=-30d
| search (Image="*git.exe" OR Image="*git" OR Image="*gh.exe" OR Image="*gh")
    (CommandLine="*auth token*" OR CommandLine="*credential*"
    OR (CommandLine="*api*" AND CommandLine="*repos*"))
| table _time, host, user, Image, CommandLine, ParentImage, ParentCommandLine
| sort - _time

// -- Variant 3: CI/CD runner spawning unexpected children --
// The attacker reached the CI/CD environment and injected code into
// backend services. Hunt self-hosted runner processes spawning
// shells, downloaders or credential-access tools. Runners run build
// scripts legitimately, so the signal is the child: a shell or
// downloader outside a known build step. Add your own runner
// binaries to the list.
index=os (sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational"
    OR sourcetype="linux:sysmon") EventCode=1 earliest=-30d
| search (ParentImage="*Runner.Listener.exe" OR ParentImage="*Runner.Worker.exe"
    OR ParentImage="*gitlab-runner*" OR ParentImage="*azure-pipelines-agent*"
    OR ParentImage="*buildagent*" OR ParentImage="*jenkins*")
    (Image="*cmd.exe" OR Image="*powershell.exe" OR Image="*pwsh*"
    OR Image="*bash" OR Image="*sh" OR Image="*curl*" OR Image="*wget*"
    OR Image="*bitsadmin*" OR Image="*certutil*" OR Image="*rundll32*"
    OR Image="*reg.exe")
| table _time, host, user, Image, CommandLine, ParentImage, ParentCommandLine
| sort - _time

// -- Variant 3b: runner or build process touching credential files --
// Same parent set, tighter filter: a build or CI process reading
// SSH keys, cloud credential files, Docker config, npmrc or
// environment files is the credential-harvesting step the 1Password
// attacker needed for infrastructure credentials.
index=os (sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational"
    OR sourcetype="linux:sysmon") EventCode=1 earliest=-30d
| search (ParentImage="*Runner.Listener.exe" OR ParentImage="*Runner.Worker.exe"
    OR ParentImage="*gitlab-runner*" OR ParentImage="*azure-pipelines-agent*"
    OR ParentImage="*buildagent*" OR ParentImage="*jenkins*"
    OR Image="*git.exe" OR Image="*gh.exe")
    (CommandLine="*.ssh*" OR CommandLine="*id_rsa*"
    OR CommandLine="*.aws*" OR CommandLine="*credentials*"
    OR CommandLine="*.docker*" OR CommandLine="*.npmrc*"
    OR CommandLine="*.env*")
| table _time, host, user, Image, CommandLine, ParentImage, ParentCommandLine
| sort - _time

// -- Variant 4: backend-service process spawning shells or downloaders --
// The injected code ran inside backend services and downloaded
// customer account records. Hunt service runtimes spawning shells,
// script interpreters or downloaders - a web or API service should
// not be launching cmd, PowerShell, curl or Python as a child.
index=os (sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational"
    OR sourcetype="linux:sysmon") EventCode=1 earliest=-30d
| search (ParentImage="*node.exe" OR ParentImage="*python.exe"
    OR ParentImage="*dotnet.exe" OR ParentImage="*w3wp.exe"
    OR ParentImage="*java*" OR ParentImage="*nginx*" OR ParentImage="*httpd*")
    (Image="*cmd.exe" OR Image="*powershell.exe" OR Image="*pwsh*"
    OR Image="*bash" OR Image="*sh" OR Image="*curl*" OR Image="*wget*"
    OR Image="*bitsadmin*" OR Image="*python*" OR Image="*perl*"
    OR Image="*ruby*")
| table _time, host, user, Image, CommandLine, ParentImage, ParentCommandLine
| sort - _time

// -- Variant 4b: new executable or script files written by a service --
// Injected backend code often drops a payload or a helper script.
// Hunt new executable, library or script files written by a service
// runtime. Legitimate services write logs and caches, not .exe,
// .dll, .ps1 or .sh files.
index=os (sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational"
    OR sourcetype="linux:sysmon") EventCode=11 earliest=-30d
| search (Image="*node.exe" OR Image="*python.exe"
    OR Image="*dotnet.exe" OR Image="*w3wp.exe"
    OR Image="*java*" OR Image="*nginx*" OR Image="*httpd*")
    (TargetFilename="*.exe" OR TargetFilename="*.dll"
    OR TargetFilename="*.ps1" OR TargetFilename="*.sh"
    OR TargetFilename="*.bat")
| table _time, host, user, Image, TargetFilename
| sort - _time

// -- Variant 5: phishing follow-on - 1Password-themed invitation or
//   recovery mail from a first-seen sender domain --
// The stolen data makes targeted phishing the realistic follow-on:
// a message using a real name and a real sign-in address, with a
// fake invitation, provisioning or account-recovery link carrying a
// stolen token. Hunt 1Password-themed invitation/recovery mail from
// a sender domain your org has never seen send such mail before.
// Replace index=email with your email gateway index and adjust the
// sender/subject field names to your ingestion.
index=email earliest=-30d
| search subject="*1Password*"
    (subject="*invit*" OR subject="*recover*" OR subject="*provision*"
    OR subject="*reset*")
| stats earliest(_time) as first_seen by sender_domain
| where first_seen > relative_time(now(), "-30d")
| sort - first_seen

// -- Variant 5b: clicks on 1Password-themed links in mail --
// Pair with variant 5: users who clicked a link in a
// 1Password-themed message. A click on a first-seen sender's link
// is the highest-priority triage - check whether the user entered
// credentials or an SSO flow afterwards.
index=email earliest=-30d
| search url="*1password*"
| table _time, user, src_ip, url, action
| sort - _time
