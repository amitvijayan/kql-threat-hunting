// Splunk SPL equivalents for the KQL hunting queries.
// Replace the index names with your own. Same logic, same write-ups.

// -- Variant 1: exposed-credential reuse - one account, many sources, fast
// (CERT-In CIAD-2026-0049: agents re-derived and reused the same exposed
// credential across separate operations; criminals ran parallel intrusions,
// compressing intrusion-to-impact from days to hours.)
index=YOUR_CLOUDAPP_INDEX earliest=-1d
| stats count as actions, dc(IPAddress) as ips, dc(AppName) as apps,
        dc(CountryCode) as countries, min(_time) as first, max(_time) as last,
        values(ActionType) as action_types, values(IPAddress) as ip_list
        by AccountObjectId, AccountDisplayName
| where actions >= 500 AND ips >= 5
| eval span_hours = (last - first) / 3600
| table AccountDisplayName, AccountObjectId, actions, ips, apps, countries,
        span_hours, first, last, action_types, ip_list
| sort 0 - ips, - actions

// -- Variant 2: enumeration bursts / bulk reads at the API layer
index=YOUR_CLOUDAPP_INDEX earliest=-15d
| where match(ActionType, "(?i)(read|query|search|get|list|download|export)")
| bin _time span=1h as hour
| stats count as hourly_reads by AccountObjectId, AccountDisplayName, hour
| eventstats median(hourly_reads) as med_hourly by AccountObjectId, AccountDisplayName
| where hour >= relative_time(now(), "-1d") AND hourly_reads >= 5000
| where hourly_reads >= 8 * if(med_hourly < 1, 1, med_hourly)
| eval surge = round(hourly_reads / if(med_hourly < 1, 1, med_hourly), 1)
| table hour, AccountDisplayName, AccountObjectId, hourly_reads, med_hourly, surge
| sort 0 - surge
