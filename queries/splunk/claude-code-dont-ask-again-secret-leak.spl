// Splunk SPL equivalents for the KQL hunting queries.
// Feed it your endpoint file, process and network logs (index and field
// names shown here are examples - replace them with your own). Same logic,
// same write-up. The queries use no invented IoCs - the filenames and
// figures are the ones reported by Apiiro in the November 5, 2026 research.

// -- Variant 1: Claude Code settings files present on endpoints --
// The allow rules live in .claude/settings.local.json (per-project) or
// .claude/settings.json (shared). Any machine with one of these files is
// a candidate for exposure - the file only becomes a leak if it is
// committed, but you cannot assess that without knowing where it exists.
index=endpoint (file_name="settings.local.json" OR file_name="settings.json") file_path="*.claude*" earliest=-60d
| table _time, host, action, file_name, file_path, process, file_hash
| sort - _time

// -- Variant 2: git staging, committing or pushing the settings file --
// The exposure happens the moment the file is added or committed to a
// repository. Hunt git commands whose command line references the settings
// filename together with add, commit or push.
index=endpoint process_name="git.exe" (process="*settings.local.json*" OR process="*settings.json*") (process="*add*" OR process="*commit*" OR process="*push*") earliest=-60d
| table _time, host, process_name, process, parent_process
| sort - _time

// -- Variant 3: git pushes to GitHub from devices carrying the file --
// The subsearch first lists devices with a Claude Code settings file; the
// outer search then looks for git pushes and git.exe network traffic to
// github.com on those devices - the chain that turns a local allow rule
// into a public secret.
index=endpoint process_name="git.exe" process="*push*" earliest=-60d
[ search index=endpoint (file_name="settings.local.json" OR file_name="settings.json") file_path="*.claude*" earliest=-60d | stats count by host | fields host ]
| table _time, host, process_name, process, parent_process
| sort - _time

// -- git.exe network traffic to github.com on the same devices --
index=network process="git.exe" url="*github.com*" earliest=-60d
[ search index=endpoint (file_name="settings.local.json" OR file_name="settings.json") file_path="*.claude*" earliest=-60d | stats count by host | fields host ]
| table _time, host, process, url, dest_ip, dest_port
| sort - _time
