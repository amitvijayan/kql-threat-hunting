// Splunk SPL equivalents for the KQL hunting queries.
// Feed it your network/firewall logs, Sysmon/process-creation events and
// file-creation events, plus your Kubernetes audit log where available.
// Replace the index names with your own. Same logic, same write-ups.
// Intrusion window: November 17, 2026, about 00:20-22:00 UTC. Published
// IoCs: 23.224.79.106, 23.224.0.0/15, pod/object prefixes i1, glm-, probe.

// -- Variant 1: egress to the published Rackspace Spot IoC range --
// 23.224.0.0/15 covers 23.224.0.0 - 23.225.255.255. Any egress from your
// fleet to that range is worth triaging immediately.
index=net (dest_ip="23.224.79.106" OR dest_ip="23.224.*" OR dest_ip="23.225.*") earliest=-30d
| table _time, src, user, process_name, dest_ip, dest_port, url
| sort - _time

// -- Variant 2: kubectl creating pods with the published prefixes --
// The "probe" prefix is noisy (liveness/readiness probes mention it
// legitimately) - triage on the full pod name; i1-* and glm-* are far
// more specific. Baseline your own naming conventions first.
index=os (sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational"
    OR sourcetype="linux:sysmon") EventCode=1 earliest=-30d
| search (Image="*kubectl*" OR Image="*kubectl.exe")
    (CommandLine="*create*" OR CommandLine="*run*" OR CommandLine="*apply*")
    (CommandLine="*i1-*" OR CommandLine="*glm-*" OR CommandLine="*probe*")
| table _time, host, user, CommandLine, ParentImage, ParentCommandLine
| sort - _time

// -- Variant 3: kubectl reading Kubernetes Secrets --
// Flag secret reads outside a known change window, from an unusual
// account or host, or against production namespaces.
index=os (sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational"
    OR sourcetype="linux:sysmon") EventCode=1 earliest=-30d
| search (Image="*kubectl*" OR Image="*kubectl.exe")
    (CommandLine="*secret*" OR CommandLine="*secrets*")
    (CommandLine="*get*" OR CommandLine="*describe*" OR CommandLine="*edit*")
| table _time, host, user, CommandLine, ParentImage, ParentCommandLine
| sort - _time

// -- Variant 4: kubectl or kubelet spawning shells/downloaders --
index=os (sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational"
    OR sourcetype="linux:sysmon") EventCode=1 earliest=-30d
| search (ParentImage="*kubectl*" OR ParentImage="*kubectl.exe"
     OR ParentImage="*kubelet*" OR ParentImage="*kubelet.exe"
     OR ParentImage="*kube-proxy*" OR ParentImage="*kube-proxy.exe")
    (Image="*sh" OR Image="*bash" OR Image="*dash" OR Image="*zsh"
     OR Image="*ksh" OR Image="*curl*" OR Image="*wget*" OR Image="*nc*"
     OR Image="*ncat*" OR Image="*socat*" OR Image="*perl*" OR Image="*ruby*"
     OR Image="*python*" OR Image="*powershell.exe" OR Image="*cmd.exe"
     OR Image="*certutil.exe" OR Image="*bitsadmin.exe" OR Image="*mshta.exe")
| eval suspicion=if(match(Image,
    "(?i)(sh$|bash|dash|zsh|ksh$|powershell\.exe|cmd\.exe)"), 2, 1)
| table _time, host, user, ParentImage, ParentCommandLine, Image, CommandLine,
        suspicion
| sort - suspicion, - _time

// -- Variant 5: non-kubectl processes reading kubeconfig or token files --
// The legitimate readers are kubectl and the Kubernetes components, and
// they are excluded.
index=os EventCode=11 earliest=-30d
| search (TargetFilename="*.kube*" OR TargetFilename="*kubeconfig*"
     OR TargetFilename="*serviceaccount*" OR TargetFilename="*service-account*")
| search NOT (Image="*kubectl*" OR Image="*kubectl.exe"
    OR Image="*kubelet*" OR Image="*kubelet.exe"
    OR Image="*kube-proxy*" OR Image="*kube-proxy.exe"
    OR Image="*kube-apiserver*" OR Image="*kube-controller-manager*"
    OR Image="*kube-scheduler*")
| table _time, host, user, TargetFilename, Image, CommandLine
| sort - _time
