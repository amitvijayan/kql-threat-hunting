// Splunk SPL equivalents for the KQL hunting queries.
// Feed it your endpoint process and file logs (index and field
// names shown here are examples - replace them with your own). Same logic,
// same write-up. The queries use no invented IoCs - the brief names the
// "wfx-docs" branch, the "docs: dependency audit notes" pull-request
// title, the 1,500-line shell script and its collection scope, and the
// three poisoned package releases; the actor is unnamed, how the 4,837
// credentials were originally obtained is not known, and the two
// exfiltration endpoints were not named, so every query hunts the
// behaviour on self-hosted runners plus the named GitHub-side markers.

// -- Variant 1: a GitHub Actions runner process reading credential files --
// The harvesting script's core job is reading secrets off the runner:
// .env files, private keys, cloud credential stores, package-manager
// and infrastructure credential files. A build legitimately reads some
// of these, so this variant is scoped to the campaign window (7 days
// from the November 10 start) and to reads initiated by the runner
// worker/listener processes themselves. Triage any hit against the
// workflow that ran on that host at that time: a run whose workflow
// file was modified, a new workflow on a short-lived branch, or an
// npm install hook is the delivery pattern from the brief.
index=endpoint (parent_process_name="Runner.Worker.exe" OR parent_process_name="Runner.Worker" OR parent_process_name="Runner.Listener.exe" OR parent_process_name="Runner.Listener" OR parent_process_name="runsvc.sh") (file_name=".env" OR file_name="id_rsa" OR file_name="id_ed25519" OR file_name="id_ecdsa" OR file_name="id_dsa" OR file_name="credentials" OR file_name=".npmrc" OR file_name=".pypirc" OR file_name=".dockercfg" OR file_name="kubeconfig" OR file_name="terraform.tfvars" OR file_name=".netrc" OR file_name=".git-credentials" OR file_name=".bash_history" OR file_name=".zsh_history" OR file_path="*.aws*" OR file_path="*.kube*" OR file_path="*.ssh*" OR file_path="*.docker*" OR file_path="*.gnupg*" OR file_path="*.terraform*" OR file_path="*.config/gcloud*") earliest=-7d
| table _time, host, action, file_name, file_path, file_hash, parent_process_name, parent_process, process, user
| sort - _time

// -- Variant 2: a runner-launched process reaching cloud instance metadata --
// The script harvested credentials exposed through instance metadata on
// self-hosted runners. A normal build has no reason to query the cloud
// metadata service, so any process launched by the runner whose command
// line touches the metadata endpoint is a strong signal. The Google
// metadata hostname is included because the brief names GCP credentials
// among the harvested material.
index=endpoint (parent_process_name="Runner.Worker.exe" OR parent_process_name="Runner.Worker" OR parent_process_name="Runner.Listener.exe" OR parent_process_name="Runner.Listener" OR parent_process_name="runsvc.sh") (process="*169.254.169.254*" OR process="*metadata.google.internal*") earliest=-7d
| table _time, host, process_name, process, parent_process_name, parent_process, user
| sort - _time

// -- Variant 3: a runner-launched process building or posting a tarball --
// The script compressed its haul into tarballs and exfiltrated them via
// HTTP POST. This variant lists tar, curl and wget processes launched by
// the runner whose command line references an archive or a POST body -
// the two halves of that exfiltration step. A tarball created on a
// runner shortly before a curl POST from the same host is the pattern
// to confirm; either half alone is worth a look in the campaign window.
index=endpoint (parent_process_name="Runner.Worker.exe" OR parent_process_name="Runner.Worker" OR parent_process_name="Runner.Listener.exe" OR parent_process_name="Runner.Listener" OR parent_process_name="runsvc.sh") (process_name="tar" OR process_name="curl" OR process_name="curl.exe" OR process_name="wget" OR process_name="wget.exe") (process="*.tar*" OR process="*.tgz*" OR process="*tar.gz*" OR process="*--data*" OR process="*-d @*" OR process="*-F @*" OR process="*--upload-file*") earliest=-7d
| table _time, host, process_name, process, parent_process_name, parent_process, user
| sort - _time
